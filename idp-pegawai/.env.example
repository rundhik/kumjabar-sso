# Local Docker development (copy to .env and adjust only if needed)
# === Identitas Aplikasi ===
APP_NAME="IDP Pegawai"
FLASK_APP="run.py"
# Pilihan: production, development
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_PORT=5000 # Port default untuk development, ganti ke 80 untuk production
FLASK_SECRET_KEY=ganti-dengan-random-string-32-karakter
APP_TIMEZONE=Asia/Jakarta
PYTHONUNBUFFERED=1

# === CORS Configuration ===
# Daftar asal yang diizinkan untuk CORS, pisahkan dengan koma.
# Contoh: http://localhost:5000,https://idp-jabar.kemenkum.go.id,https://api.jabarprov.go.id
CORS_ALLOWED_ORIGINS=http://localhost:9000

# === Database Configuration ===
# Pilihan driver: pgsql, mysql, oracle, sqlite
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

TEST_DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Database Keycloak
KEYCLOAK_DB_HOST=global_postgresql
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=postgres
KEYCLOAK_DB_PASSWORD=12345678

# Bootstrap admin Keycloak development
KEYCLOAK_ADMIN_USERNAME=  #(keycloak realm master user, admin)
KEYCLOAK_ADMIN_PASSWORD=  #(keycloak realm master password, admin)

# Konfigurasi IDP ke Keycloak
KEYCLOAK_URL=  #http://kumjabar_keycloak:8080
KEYCLOAK_REALM=  #kumjabar
KEYCLOAK_CLIENT_ID=  #idp-pegawai-admin
KEYCLOAK_CLIENT_SECRET=  #secret key dari clients: idp-pegawai-admin

# Token exchange IDP ke Keycloak dan ke aplikasi client
INTERNAL_PROFILE_ISSUER=  #http://localhost:8080/realms/kumjabar
INTERNAL_PROFILE_AUDIENCE=  #idp-pegawai-internal
INTERNAL_PROFILE_CLIENT=  #s1-jabar-token-exchange

# JWKS — Peringkat 2: file terpisah (rapi, readiness). Contoh: pub_certs.json (lihat pub_certs.example.json)
INTERNAL_PROFILE_JWKS_PATH=pub_certs.json
# Peringkat 1 (best practice): fetch dinamis dari Keycloak certs + cache. Nyalakan bila jaringan ke Keycloak tersedia.
# Kosong = derives ke ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs
INTERNAL_PROFILE_JWKS_URL=  #http://kumjabar_keycloak:8080/realms/kumjabar/protocol/openid-connect/certs
INTERNAL_PROFILE_JWKS_FETCH_ENABLED=false  #true untuk Peringkat 1 (Zero-Maintenance rotasi)
INTERNAL_PROFILE_JWKS_CACHE_TTL=3600  #detik, overlap key tetap dipakai bila fetch gagal

SWAGGER_TITLE=Kumjabar SSO API

# === SQLAlchemy Tweaks ===
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_ECHO=False
SQLALCHEMY_RECORD_QUERIES=True

# === Redis & Cache ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Session Configuration ===
SESSION_KEY_PREFIX=idpjabar_

# === Flask JWT ===
JWT_SECRET_KEY=ganti-dengan-random-string-64-karakter

# === Mail Configuration (Penting untuk Notifikasi) ===
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=email@gmail.com
# MAIL_PASSWORD=app-password-kamu
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false

# === Untuk trial bisa pakai mailtrap.io. ===
MAIL_SERVER='sandbox.smtp.mailtrap.io'
MAIL_PORT=2525 # Atau port lain yang disediakan Mailtrap
MAIL_USERNAME='' # Dari Mailtrap
MAIL_PASSWORD='' # Dari Mailtrap
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_SUPPRESS_SEND=False
MAIL_DEBUG=True

MAIL_DEFAULT_SENDER="IDP Jabar <no-reply@kemenkum.go.id>"

# Celery / analytics async refresh
CELERY_BROKER_URL=redis://global_redis:6379/0
CELERY_RESULT_BACKEND=redis://global_redis:6379/0
CELERY_TASK_IGNORE_RESULT=true

