# Local Docker development (copy to .env and adjust only if needed)

# Database Keycloak
KEYCLOAK_DB_HOST= #global_postgresql
KEYCLOAK_DB_PORT= #5432
KEYCLOAK_DB_NAME= #keycloak
KEYCLOAK_DB_USER= #username
KEYCLOAK_DB_PASSWORD= #12345678

# Bootstrap admin Keycloak development
KEYCLOAK_ADMIN_USERNAME= #admin
KEYCLOAK_ADMIN_PASSWORD= #admin
